# Copy this file to .env and fill in your values.
# The pipeline loads .env automatically via python-dotenv.

# ── Deepgram (speech-to-text, used by rag_mcp.py for voice notes) ─────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ── Ollama Cloud (embedding model bge-m3 can run locally; cloud key for chat) ──
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_key_here

# ── OpenClaw gateway token (for outbound WhatsApp image delivery) ──────────────
OPENCLAW_GATEWAY_TOKEN=your_openclaw_token_here

# ── Optional overrides ─────────────────────────────────────────────────────────
# RAG_REPLY_TO=+60123456789   # fallback WhatsApp number if sessions.json is absent
# RAG_DOCLING=1               # set to 1 to force Docling on all PDFs during ingest
